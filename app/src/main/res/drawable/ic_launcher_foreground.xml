<?xml version="1.0" encoding="utf-8"?>
<!--
  Ícone do app (5.0): um medidor. O ponteiro entra na faixa verde, que é o
  "essa corrida bate a sua meta" do cartão. Branco no preto; o verde é a
  única cor, e significa aceitar. Desenho aprovado em mockups/icone-app.html.
  Grade de 108 (ícone adaptativo): o desenho fica dentro do círculo seguro de 66.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Arco do medidor, da esquerda até o começo da faixa verde -->
    <path
        android:pathData="M22,68 A32,32 0 0,1 81.7,52"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round" />

    <!-- Faixa verde: onde a corrida bate a meta -->
    <path
        android:pathData="M81.7,52 A32,32 0 0,1 86,68"
        android:strokeColor="#00D084"
        android:strokeWidth="9"
        android:strokeLineCap="round" />

    <!-- Ponteiro -->
    <path
        android:pathData="M54,68 L73,49"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- Eixo -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,68 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0" />
</vector>
