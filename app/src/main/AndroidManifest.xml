<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Sobreposição a outros apps ("Aparecer sobre outros apps").
      A janela da oferta usa TYPE_ACCESSIBILITY_OVERLAY, que funciona SEM esta permissão
      concedida. Ela fica declarada para janelas flutuantes fora do serviço de acessibilidade
      (TYPE_APPLICATION_OVERLAY), que exigem o usuário liberar em
      Settings.ACTION_MANAGE_OVERLAY_PERMISSION.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Jornada: km rodado pelo GPS num serviço em primeiro plano (tipo location). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Notificação do turno e do resumo diário (Android 13+ pede em tempo de execução). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Pedir ao Android para não matar o leitor de ofertas por economia de bateria.
         Sem isso o serviço cai no meio do turno em celulares Xiaomi, Oppo e afins. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Login e backup na nuvem (Firebase). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Atualização do próprio app: baixar o APK e abrir o instalador do Android. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Android 11+ (visibilidade de pacotes): permite checar se a Uber Driver / 99 Motorista
      estão instaladas (PackageManager.getLaunchIntentForPackage etc.).
      Não é necessário para o AccessibilityService receber os eventos.
    -->
    <queries>
        <package android:name="com.ubercab.driver" />
        <package android:name="com.app99.driver" />
        <package android:name="br.com.ifood.driver.app" />
        <!-- Street View / Maps a partir da janela da oferta -->
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <application
        android:name=".MotoristaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Leitor de ofertas.
          - BIND_ACCESSIBILITY_SERVICE: só o sistema pode se conectar ao serviço.
          - exported="true" é obrigatório para o sistema enxergá-lo em Acessibilidade.
        -->
        <service
            android:name=".service.OfertaAccessibilityService"
            android:exported="true"
            android:label="@string/acessibilidade_nome"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Entrega o APK baixado ao instalador do Android sem expor o caminho do arquivo. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Cronômetro + GPS do turno. -->
        <service
            android:name=".jornada.JornadaService"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>
</manifest>
